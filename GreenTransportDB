/*a) Listar mantenimientos por conductor*/

SELECT c.Nombre AS Conductor, v.Marca + ' ' + v.Modelo AS Vehiculo, 
       m.FechaMantenimiento, m.Descripcion
FROM Mantenimientos m
JOIN Conductores c ON m.IdConductor = c.IdConductor
JOIN Vehiculos v ON m.IdVehiculo = v.IdVehiculo
ORDER BY c.Nombre;
/*b) Mostrar vehículos sin mantenimiento en el último mes*/

SELECT v.Marca, v.Modelo
FROM Vehiculos v
LEFT JOIN Mantenimientos m 
    ON v.IdVehiculo = m.IdVehiculo
    AND m.FechaMantenimiento >= DATEADD(MONTH, -1, GETDATE())
WHERE m.IdMantenimiento IS NULL;

