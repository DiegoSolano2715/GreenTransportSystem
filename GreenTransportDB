/*Registrar un nuevo mantenimiento y actualizar disponibilidad del vehículo:*/


BEGIN TRANSACTION;

BEGIN TRY
    DECLARE @IdVehiculo INT = 2;
    DECLARE @IdConductor INT = 1;

    -- Registrar mantenimiento
    INSERT INTO Mantenimientos (IdVehiculo, IdConductor, FechaMantenimiento, Descripcion)
    VALUES (@IdVehiculo, @IdConductor, GETDATE(), 'Revisión de frenos y sistema eléctrico');

    -- Actualizar estado y disponibilidad
    UPDATE Vehiculos
    SET Estado = 'En mantenimiento', Disponible = 0
    WHERE IdVehiculo = @IdVehiculo;

    COMMIT TRANSACTION;
    PRINT '✅ Transacción completada exitosamente.';
END TRY

BEGIN CATCH
    ROLLBACK TRANSACTION;
    PRINT '❌ Error en la transacción. Se realizó rollback.';
    PRINT ERROR_MESSAGE();
END CATCH;
