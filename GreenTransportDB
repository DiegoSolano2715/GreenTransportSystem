CREATE DATABASE GreenTransportDB;
GO
USE GreenTransportDB;
GO

-- Tabla de Vehículos
CREATE TABLE Vehiculos (
    IdVehiculo INT IDENTITY PRIMARY KEY,
    Marca NVARCHAR(50),
    Modelo NVARCHAR(50),
    Anio INT,
    Estado NVARCHAR(20) CHECK (Estado IN ('Activo', 'En mantenimiento', 'Inactivo')),
    Disponible BIT DEFAULT 1
);
GO

-- Tabla de Conductores
CREATE TABLE Conductores (
    IdConductor INT IDENTITY PRIMARY KEY,
    Nombre NVARCHAR(100),
    Licencia NVARCHAR(20),
    FechaIngreso DATE
);
GO

-- Tabla de Mantenimientos
CREATE TABLE Mantenimientos (
    IdMantenimiento INT IDENTITY PRIMARY KEY,
    IdVehiculo INT FOREIGN KEY REFERENCES Vehiculos(IdVehiculo),
    IdConductor INT FOREIGN KEY REFERENCES Conductores(IdConductor),
    FechaMantenimiento DATE,
    Descripcion NVARCHAR(200)
);
GO


